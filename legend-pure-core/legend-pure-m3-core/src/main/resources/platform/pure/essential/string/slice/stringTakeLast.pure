import meta::pure::test::pct::*;

'''
The trailing `width` characters of a string.

The mirror of `stringTake(String[1], Integer[1]):String[1]` — the characters at the end are the ones
kept, so this is the form to reach for with fixed-width suffixes such as the last four digits of an
account number.

The `width` is a maximum, not a requirement: a string already `width` characters or shorter is
returned unchanged rather than padded or rejected. A `width` of `0` keeps nothing and gives the
empty string.

The `width` must not be negative.

**Parameters**
- `str` — the string to take from.
- `width` — the maximum number of characters to keep, zero or greater.

**Returns** the trailing `width` characters, or the whole string when it is already that short.

**Examples**
```pure
'hello world'->stringTakeLast(5)    // 'world'
'hello world'->stringTakeLast(11)   // 'hello world'  -- width equals the length
'abc'->stringTakeLast(10)           // 'abc'          -- longer than the string
'abc'->stringTakeLast(0)            // ''
```

**See also** `stringTake(String[1], Integer[1]):String[1]`,
`substring(String[1], Integer[1]):String[1]`, `length(String[1]):Integer[1]`
'''
function <<PCT.function>> meta::pure::functions::string::stringTakeLast(str:String[1], width:Integer[1]):String[1]
{
    if($width < $str->length(), |$str->substring($str->length() - $width), |$str)
}

'''
The characters at the end are the ones kept, and a `width` equal to the length keeps them all.
'''
function <<PCT.test>> meta::pure::functions::string::tests::stringTakeLast::testStringTakeLast<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('world', $f->eval(|stringTakeLast('hello world', 5)));
    assertEquals('hello world', $f->eval(|stringTakeLast('hello world', 11)));
}

'''
A `width` beyond the end of the string returns it unchanged rather than raising.
'''
function <<PCT.test>> meta::pure::functions::string::tests::stringTakeLast::testStringTakeLastWidthLongerThanString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('abc', $f->eval(|stringTakeLast('abc', 10)));
}

'''
A `width` of `0` is legal and keeps nothing, giving the empty string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::stringTakeLast::testStringTakeLastWidthZero<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|stringTakeLast('abc', 0)));
}

'''
A `width` of `1` keeps a single character, not the whole string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::stringTakeLast::testStringTakeLastSingleCharacter<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('c', $f->eval(|stringTakeLast('abc', 1)));
}

'''
`stringTake` and `stringTakeLast` select opposite ends of the same string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::stringTakeLast::testStringTakeLastIsTheMirrorOfStringTake<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('the', $f->eval(|stringTake('the quick brown fox', 3)));
    assertEquals('fox', $f->eval(|stringTakeLast('the quick brown fox', 3)));
}

function <<test.Test>> meta::pure::functions::string::tests::stringTakeLast::testStringTakeLastEval():Boolean[1]
{
    assertEq('world', stringTakeLast_String_1__Integer_1__String_1_->eval('hello world', 5));
    assertEq('abc', stringTakeLast_String_1__Integer_1__String_1_->eval('abc', 10));
}
