import meta::pure::test::pct::*;

'''
The trailing `length` characters of a string.

The mirror of `left(String[1], Integer[1]):String[1]` — the characters at the end are the ones
kept. Useful for fixed-width suffixes: the quote currency of a pair, or the last four digits of
an account number kept for display while the rest stays masked.

`length` is a maximum, not a requirement: a string shorter than `length` is returned unchanged
rather than padded or rejected. A `length` of `0` returns the empty string.

The `length` must not be negative; a negative value raises an error.

**Parameters**
- `string` — the string to take from.
- `length` — the maximum number of characters to keep, zero or greater.

**Returns** the trailing `length` characters, or the whole string when it is already that short.

**Examples**
```pure
'EURUSD'->right(3)         // 'USD'   -- the quote currency of a pair
'000123456789'->right(4)   // '6789'  -- the last four digits of an account number
'EURUSD'->right(6)         // 'EURUSD'  -- length equals the string length
'GBP'->right(6)            // 'GBP'   -- shorter than the requested length
'EURUSD'->right(0)         // ''
''->right(3)               // ''
```

**See also** `left(String[1], Integer[1]):String[1]`,
`substr(String[1], Integer[1]):String[1]`, `length(String[1]):Integer[1]`
'''
function <<PCT.function>> meta::pure::functions::string::right(string:String[1], length:Integer[1]):String[1]
{
    assert($length >= 0, 'length must be >= 0');

    let strLength = $string->length();

    let firstKeptIndex = if ($length > $strLength,
                              | 0,
                              | $strLength - $length);

    $string->substr($firstKeptIndex, $strLength);
}

'''
The characters at the end are the ones kept.
'''
function <<PCT.test>> meta::pure::functions::string::tests::right::testRight<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('USD', $f->eval(|'EURUSD'->right(3)));
    assertEquals('6789', $f->eval(|'000123456789'->right(4)));
}

'''
A `length` equal to the string length keeps every character.
'''
function <<PCT.test>> meta::pure::functions::string::tests::right::testRightExactLength<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('EURUSD', $f->eval(|'EURUSD'->right(6)));
}

'''
A `length` beyond the end of the string returns it unchanged rather than raising.
'''
function <<PCT.test>> meta::pure::functions::string::tests::right::testRightTooShortString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('GBP', $f->eval(|'GBP'->right(6)));
}

'''
A `length` of `0` is legal and keeps nothing, giving the empty string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::right::testRightZeroLength<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|'EURUSD'->right(0)));
}

'''
An empty string has no trailing characters to keep, whatever the `length`.
'''
function <<PCT.test>> meta::pure::functions::string::tests::right::testRightEmptyString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|''->right(3)));
}

'''
`left` and `right` select opposite ends of the same string, splitting a currency pair into its
base and quote halves.
'''
function <<PCT.test>> meta::pure::functions::string::tests::right::testRightIsTheMirrorOfLeft<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('EUR', $f->eval(|'EURUSD'->left(3)));
    assertEquals('USD', $f->eval(|'EURUSD'->right(3)));
}

function <<test.Test>> meta::pure::functions::string::tests::right::testRightNegativeLength():Boolean[1]
{
    assertError(|'EURUSD'->right(-1), 'length must be >= 0');
}
