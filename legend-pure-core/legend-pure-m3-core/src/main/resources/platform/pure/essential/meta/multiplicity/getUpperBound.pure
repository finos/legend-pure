import meta::pure::test::pct::*;

'''
The maximum number of values a multiplicity permits.

**Only meaningful when the multiplicity actually has an upper bound** — test with
`hasUpperBound(Multiplicity[1]):Boolean[1]` first. For an unbounded multiplicity such as `ZeroMany` or
`OneMany` there is no upper bound to report, so the result is not a usable count.

**Parameters**
- `multiplicity` — the multiplicity to inspect.

**Returns** the upper bound, for a multiplicity that has one.

**Examples**
```pure
PureZero->getUpperBound()   // 0
ZeroOne->getUpperBound()    // 1
PureOne->getUpperBound()    // 1

if($m->hasUpperBound(), |$m->getUpperBound()->toString(), |'unbounded')
```

**See also** `hasUpperBound(Multiplicity[1]):Boolean[1]`,
`getLowerBound(Multiplicity[1]):Integer[1]`,
`isToMany(Multiplicity[1]):Boolean[1]`
'''
function <<PCT.function, PCT.platformOnly>> meta::pure::functions::meta::getUpperBound(multiplicity:Multiplicity[1]):Integer[1]
{
    $multiplicity.upperBound->toOne().value->toOne()
}

function <<test.Test>> meta::pure::functions::multiplicity::tests::getUpperBound::testGetUpperBound():Boolean[1]
{
    assertEq(0, PureZero->getUpperBound());
    assertEq(1, ZeroOne->getUpperBound());
    assertEq(1, PureOne->getUpperBound());
}

function <<test.Test>> meta::pure::functions::multiplicity::tests::getUpperBound::testGetUpperBoundArbitraryBound():Boolean[1]
{
    // Arbitrary [m..n] shape — the existing testGetUpperBound covers only
    // the three concrete-upper named multiplicities (PureZero / ZeroOne /
    // PureOne). ZeroMany / OneMany have no upper bound and are gated by
    // hasUpperBound() before getUpperBound() is called, so we exercise a
    // bounded user-constructed Multiplicity here.
    let m = ^Multiplicity(
        lowerBound = ^MultiplicityValue(value = 3),
        upperBound = ^MultiplicityValue(value = 7)
    );
    assertEq(7, $m->getUpperBound());
}

function <<test.Test>> meta::pure::functions::multiplicity::tests::getUpperBound::testGetUpperBoundZeroManyError():Boolean[1]
{
    assertError(|ZeroMany->getUpperBound(), 'Cannot cast a collection of size 0 to multiplicity [1]');
}

function <<test.Test>> meta::pure::functions::multiplicity::tests::getUpperBound::testGetUpperBoundOneManyError():Boolean[1]
{
    assertError(|OneMany->getUpperBound(), 'Cannot cast a collection of size 0 to multiplicity [1]');
}