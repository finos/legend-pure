import meta::pure::test::pct::*;

'''
The portion of a string from `start` to its end.

A synonym for `substring(String[1], Integer[1]):String[1]`, behaving identically to it.
`left(String[1], Integer[1]):String[1]` and `right(String[1], Integer[1]):String[1]` are both
defined in terms of `substr`, making it the single point at which the string-slicing family
reaches the underlying platform primitive.

Positions are zero-based, so `start` is the number of characters to drop from the front. A `start`
of `0` returns the whole string. Note that `start` is a position, not a length — to keep a given
number of leading characters, use `left(String[1], Integer[1]):String[1]`.

**Parameters**
- `str` — the string to take from.
- `start` — zero-based index of the first character to keep.

**Returns** the remainder of the string from `start` onwards.

**Examples**
```pure
'the quick brown'->substr(0)   // 'the quick brown'
'the quick brown'->substr(4)   // 'quick brown'
```

**See also** `substr(String[1], Integer[1], Integer[1]):String[1]`,
`substring(String[1], Integer[1]):String[1]`, `left(String[1], Integer[1]):String[1]`
'''
function <<PCT.function>> meta::pure::functions::string::substr(str:String[1], start:Integer[1]):String[1]
{
    $str->substring($start)
}

'''
The portion of a string between two positions: from `start` inclusive to `end` exclusive.

As `substr(String[1], Integer[1]):String[1]`, but stopping at `end` rather than running to the
end of the string. Both indexes are zero-based, so the result has `end - start` characters. A
synonym for `substring(String[1], Integer[1], Integer[1]):String[1]`.

**Examples**
```pure
'the quick brown fox'->substr(4, 9)   // 'quick'
'the quick brown fox'->substr(0, 3)   // 'the'
```
'''
function <<PCT.function>> meta::pure::functions::string::substr(str:String[1], start:Integer[1], end:Integer[1]):String[1]
{
    $str->substring($start, $end)
}

'''
`start` counts characters dropped from the front, so `0` returns the whole string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::substr::testSubstrStart<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let string = 'the quick brown fox jumps over the lazy dog';
    assertEquals('the quick brown fox jumps over the lazy dog', $f->eval(|substr($string, 0)));
    assertEquals('he quick brown fox jumps over the lazy dog', $f->eval(|substr($string, 1)));
    assertEquals('quick brown fox jumps over the lazy dog', $f->eval(|substr($string, 4)));
}

'''
`end` is exclusive, so the slice spans `end - start` characters.
'''
function <<PCT.test>> meta::pure::functions::string::tests::substr::testSubstrStartEnd<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let string = 'the quick brown fox jumps over the lazy dog';
    assertEquals('the quick brown fox jumps over the lazy dog', $f->eval(|substr($string, 0, 43)));
    assertEquals('quick', $f->eval(|substr($string, 4, 9)));
    assertEquals('the', $f->eval(|substr($string, 0, 3)));
}

'''
A `start` equal to the length, or a range of zero width, yields the empty string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::substr::testSubstrEmptyResult<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|substr('abc', 3)));
    assertEquals('', $f->eval(|substr('abc', 1, 1)));
}

function <<test.Test>> meta::pure::functions::string::tests::substr::testSubstrMatchesSubstring():Boolean[1]
{
    let string = 'the quick brown fox';
    assertEquals(substring($string, 4), substr($string, 4));
    assertEquals(substring($string, 4, 9), substr($string, 4, 9));
}

function <<test.Test>> meta::pure::functions::string::tests::substr::testSubstrEval():Boolean[1]
{
    assertEq('quick brown', substr_String_1__Integer_1__String_1_->eval('the quick brown', 4));
    assertEq('quick', substr_String_1__Integer_1__Integer_1__String_1_->eval('the quick brown fox', 4, 9));
}
