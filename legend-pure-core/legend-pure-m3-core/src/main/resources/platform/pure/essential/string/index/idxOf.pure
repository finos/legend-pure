import meta::pure::test::pct::*;

'''
The zero-based position of the first occurrence of `toFind` in `str`, or `-1` if it does not occur.

Positions are zero-based, so a match at the very start of the string is `0`. Because a miss returns
`-1` rather than an empty value, test the result explicitly rather than relying on it being empty.

**Parameters**
- `str` — the string to search in.
- `toFind` — the substring to locate.

**Returns** the index of the first occurrence, or `-1` when there is none.

**Examples**
```pure
'the quick brown fox'->idxOf('quick')   // 4
'the quick brown fox'->idxOf('fox')     // 16
'the quick brown fox'->idxOf('happy')   // -1
```

**See also** `idxOf(String[1], String[1], Integer[1]):Integer[1]`,
`lastIdxOf(String[1], String[1]):Integer[1]`, `contains(String[1], String[1]):Boolean[1]`,
`substr(String[1], Integer[1], Integer[1]):String[1]`
'''
function <<PCT.function>> meta::pure::functions::string::idxOf(str:String[1], toFind:String[1]):Integer[1]
{
    $str->indexOf($toFind)
}

'''
As `idxOf(String[1], String[1]):Integer[1]`, but begins searching at `fromIndex` rather than at the
start of the string. Still returns `-1` when there is no occurrence at or after that position.

**Examples**
```pure
'the the'->idxOf('h', 0)   // 1
'the the'->idxOf('h', 3)   // 5
```
'''
function <<PCT.function>> meta::pure::functions::string::idxOf(str:String[1], toFind:String[1], fromIndex:Integer[1]):Integer[1]
{
    $str->indexOf($toFind, $fromIndex)
}

'''
Positions are zero-based, so a match at the start is `0`, and a substring that is absent gives `-1`.
'''
function <<PCT.test>> meta::pure::functions::string::tests::idxOf::testIdxOfSimple<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let string = 'the quick brown fox jumps over the lazy dog';

    assertEquals(0, $f->eval(|$string->idxOf('the')));
    assertEquals(4, $f->eval(|$string->idxOf('quick')));
    assertEquals(16, $f->eval(|$string->idxOf('fox')));
    assertEquals(-1, $f->eval(|$string->idxOf('happy')));
}

'''
Raising `fromIndex` past the first occurrence finds the next one instead.
'''
function <<PCT.test>> meta::pure::functions::string::tests::idxOf::testIdxOfFromIndex<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    let string = 'the the';

    assertEquals(1, $f->eval(|$string->idxOf('h', 0)));
    assertEquals(5, $f->eval(|$string->idxOf('h', 3)));
}

function <<test.Test>> meta::pure::functions::string::tests::idxOf::testIdxOfMatchesIndexOf():Boolean[1]
{
    let string = 'the quick brown fox';
    assertEquals(indexOf($string, 'quick'), idxOf($string, 'quick'));
    assertEquals(indexOf($string, 'o', 13), idxOf($string, 'o', 13));
}

function <<test.Test>> meta::pure::functions::string::tests::idxOf::testIdxOfEval():Boolean[1]
{
    assertEq(4, idxOf_String_1__String_1__Integer_1_->eval('the quick brown fox', 'quick'));
    assertEq(5, idxOf_String_1__String_1__Integer_1__Integer_1_->eval('the the', 'h', 3));
}
