import meta::pure::test::pct::*;

'''
The leading `length` characters of a string.

Useful for reading a fixed-width prefix out of a coded identifier — the base currency of a pair,
the country code of an ISIN, a product or branch prefix.

`length` is a maximum, not a requirement: a string shorter than `length` is returned unchanged
rather than padded or rejected, so this is safe to apply across a column of mixed-length values.
A `length` of `0` returns the empty string.

Note that `length` is a count, not a position — unlike
`substr(String[1], Integer[1]):String[1]`, which takes an index and drops what comes before
it. `'EURUSD'->left(3)` gives `'EUR'`, while `'EURUSD'->substr(3)` gives `'USD'`.

The `length` must not be negative; a negative value raises an error.

**Parameters**
- `string` — the string to take from.
- `length` — the maximum number of characters to keep, zero or greater.

**Returns** the leading `length` characters, or the whole string when it is already that short.

**Examples**
```pure
'EURUSD'->left(3)         // 'EUR'  -- the base currency of a pair
'US0378331005'->left(2)   // 'US'   -- the country code of an ISIN
'EURUSD'->left(6)         // 'EURUSD'  -- length equals the string length
'GBP'->left(6)            // 'GBP'  -- shorter than the requested length
'EURUSD'->left(0)         // ''
''->left(3)               // ''
```

**See also** `right(String[1], Integer[1]):String[1]`,
`substr(String[1], Integer[1]):String[1]`, `length(String[1]):Integer[1]`
'''
function <<PCT.function>> meta::pure::functions::string::left(string:String[1], length:Integer[1]):String[1]
{
    assert($length >= 0, 'length must be >= 0');

    let strLength = $string->length();

    let charsToKeep = if ($length > $strLength,
                           | $strLength,
                           | $length);

    $string->substr(0, $charsToKeep);
}

'''
The characters at the front are the ones kept.
'''
function <<PCT.test>> meta::pure::functions::string::tests::left::testLeft<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('EUR', $f->eval(|'EURUSD'->left(3)));
    assertEquals('US', $f->eval(|'US0378331005'->left(2)));
}

'''
A `length` equal to the string length keeps every character.
'''
function <<PCT.test>> meta::pure::functions::string::tests::left::testLeftExactLength<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('EURUSD', $f->eval(|'EURUSD'->left(6)));
}

'''
A `length` beyond the end of the string returns it unchanged rather than raising.
'''
function <<PCT.test>> meta::pure::functions::string::tests::left::testLeftTooShortString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('GBP', $f->eval(|'GBP'->left(6)));
}

'''
A `length` of `0` is legal and keeps nothing, giving the empty string.
'''
function <<PCT.test>> meta::pure::functions::string::tests::left::testLeftZeroLength<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|'EURUSD'->left(0)));
}

'''
An empty string has no leading characters to keep, whatever the `length`.
'''
function <<PCT.test>> meta::pure::functions::string::tests::left::testLeftEmptyString<Z|y>(f:Function<{Function<{->Z[y]}>[1]->Z[y]}>[1]):Boolean[1]
{
    assertEquals('', $f->eval(|''->left(3)));
}

function <<test.Test>> meta::pure::functions::string::tests::left::testLeftNegativeLength():Boolean[1]
{
    assertError(|'EURUSD'->left(-1), 'length must be >= 0');
}
