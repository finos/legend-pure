<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>org.finos.legend.pure</groupId>
        <artifactId>legend-pure</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>legend-pure-rust</artifactId>
    <packaging>pom</packaging>
    <name>Legend Pure - Rust</name>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-rust-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-rust-api</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-rust-jni</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-rust-jni</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
            <dependency>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-rust-ffm</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.finos.legend.pure</groupId>
                <artifactId>legend-pure-rust-ffm</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- These modules' bytecode targets 17 or 25, above the release the rest of the
                         reactor targets. Their tests fork the JVM Maven runs on, which the profiles
                         below already hold at or above each module's floor, and never a lower one
                         passed as -Djvm (the shared CI points every module's tests at each matrix
                         JDK, 8 included). -->
                    <jvm>${java.home}/bin/java</jvm>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- legend-pure-rust-api, -jni, -ffm and -bench are added by the profiles below; on JDK 11 this aggregator holds nothing. -->
    <profiles>
        <profile>
            <id>rust-evaluator-jdk17</id>
            <activation>
                <jdk>[17,)</jdk>
            </activation>
            <modules>
                <module>legend-pure-rust-api</module>
                <module>legend-pure-rust-jni</module>
            </modules>
        </profile>
        <profile>
            <id>rust-evaluator-jdk25</id>
            <activation>
                <jdk>[25,)</jdk>
            </activation>
            <modules>
                <module>legend-pure-rust-ffm</module>
                <module>legend-pure-rust-bench</module>
            </modules>
        </profile>
    </profiles>
</project>
